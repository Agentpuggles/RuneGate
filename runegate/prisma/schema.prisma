generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  avatar       String   @default("default")
  profileImage String?
  bio          String   @default("")
  title        String   @default("Wanderer")
  rank         String   @default("Initiate")
  level        Int      @default(1)
  xp           Int      @default(0)
  gold         Int      @default(100)
  createdAt    DateTime @default(now())
  lastLogin    DateTime @default(now())

  gameSessions  GameSession[]
  favorites     Favorite[]
  messages      Message[]
  searchLogs    SearchLog[]
  notes         Note[]
  scores        ScoreEntry[]
}

model Game {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  category    String
  thumbnail   String
  image       String   @default("")
  embedUrl    String
  embedType   String   @default("iframe")
  controls    String
  rating      Float    @default(0)
  plays       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sessions  GameSession[]
  favorites Favorite[]
  scores    ScoreEntry[]
}

model GameSession {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  playedAt  DateTime @default(now())
  duration  Int      @default(0)

  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])
}

model Favorite {
  id     String @id @default(uuid())
  userId String
  gameId String

  user   User   @relation(fields: [userId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

model Channel {
  id          String    @id @default(uuid())
  name        String    @unique
  description String
  icon        String    @default("💬")
  createdAt   DateTime  @default(now())

  messages    Message[]
}

model Message {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  content   String
  type      String   @default("message")
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SearchLog {
  id        String   @id @default(uuid())
  userId    String
  query     String
  mode      String   @default("scroll")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model ScoreEntry {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  score     Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])
}
